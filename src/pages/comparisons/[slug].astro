---
import { getCollection, render } from 'astro:content';
import ComparisonLayout from '@/layouts/ComparisonLayout.astro';
import { estimateReadingTime } from '@/utils/content';

export async function getStaticPaths() {
  const entries = await getCollection('comparisons', ({ data }) => !data.draft);
  return entries.map((entry) => {
    const slug = entry.data.slug || entry.id.replace(/\.(md|mdx)$/, '');
    return {
      params: { slug },
      props: { entry, slug },
    };
  });
}

const { entry, slug } = Astro.props;
const { Content } = await render(entry);
const { minutes, chars } = estimateReadingTime(entry.body || '');
---

<ComparisonLayout
  title={entry.data.title}
  seoTitle={entry.data.seoTitle}
  description={entry.data.description}
  excerpt={entry.data.excerpt}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  category={entry.data.category}
  tags={entry.data.tags}
  cover={entry.data.cover}
  coverAlt={entry.data.coverAlt}
  author={entry.data.author}
  readingTimeMinutes={minutes}
  wordCount={chars}
  faq={entry.data.faq}
  sources={entry.data.sources}
  relatedBrands={entry.data.relatedBrands}
  relatedSlugs={entry.data.relatedSlugs}
  priceVerifiedDate={entry.data.priceVerifiedDate}
  testDate={entry.data.testDate}
  rawBody={entry.body || ''}
  currentUrl={`/comparisons/${slug}/`}
  comparedItems={entry.data.comparedItems}
  comparisonDimension={entry.data.comparisonDimension}
>
  <Content />
</ComparisonLayout>
