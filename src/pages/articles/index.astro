---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/navigation/Breadcrumb.astro';
import ArticleCard from '@/components/cards/ArticleCard.astro';
import SearchBox from '@/components/search/SearchBox.astro';
import { getAllPublishedContent } from '@/utils/content';

const allContent = await getAllPublishedContent();
const allTags = Array.from(new Set(allContent.flatMap((c) => c.tags))).slice(0, 24);
---

<BaseLayout
  title="全部原创评测文章与客户端教程索引 - v2rayn指南"
  description="浏览 v2rayn指南 全部原创深度文章：涵盖 2026 机场推荐、五维实测排行、IEPL/IPLC 专线解析、v2rayN 与 Clash Verge Rev 客户端教程及防跑路风险情报。"
  breadcrumbs={[{ name: '全部文章与教程', url: '/articles/' }]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
    <Breadcrumb items={[{ name: '全部文章与教程', url: '/articles/' }]} />

    <div class="max-w-3xl mb-8">
      <span class="text-xs font-bold uppercase tracking-wider text-blue-600">EDITORIAL ARCHIVE</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-1">
        原创文章、品牌评测与客户端实操文库 ({allContent.length} 篇已发布)
      </h1>
      <p class="text-base text-slate-600 mt-2">
        所有已发布文章均采用 Answer-First 结构编写，支持按一级频道或熱門标签筛选。
      </p>
    </div>

    <div class="mb-8">
      <SearchBox />
    </div>

    <!-- 分类与标签筛选栏 -->
    <div class="editorial-card p-4 sm:p-5 bg-slate-50 mb-8 space-y-3">
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="font-bold text-slate-700 mr-1">按内容类型筛选：</span>
        <button type="button" data-col-filter="all" class="col-filter-btn px-3 py-1.5 rounded-lg bg-blue-600 text-white font-bold cursor-pointer">
          全部内容 ({allContent.length})
        </button>
        <button type="button" data-col-filter="articles" class="col-filter-btn px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 hover:text-blue-600 font-semibold cursor-pointer">
          专题长文
        </button>
        <button type="button" data-col-filter="reviews" class="col-filter-btn px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 hover:text-blue-600 font-semibold cursor-pointer">
          品牌深度评测
        </button>
        <button type="button" data-col-filter="comparisons" class="col-filter-btn px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 hover:text-blue-600 font-semibold cursor-pointer">
          多维横向对比
        </button>
        <button type="button" data-col-filter="guides" class="col-filter-btn px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 hover:text-blue-600 font-semibold cursor-pointer">
          客户端实操教程
        </button>
      </div>

      <div class="flex flex-wrap items-center gap-1.5 text-xs pt-2 border-t border-slate-200/80">
        <span class="font-bold text-slate-700 mr-1">热门标签：</span>
        {
          allTags.map((tag) => (
            <button
              type="button"
              data-tag-filter={tag}
              class="tag-filter-btn px-2.5 py-1 rounded-md bg-white border border-slate-200 text-slate-600 hover:border-blue-500 hover:text-blue-600 cursor-pointer"
            >
              #{tag}
            </button>
          ))
        }
      </div>
    </div>

    <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        allContent.map((item) => (
          <div
            class="article-item"
            data-collection={item.collection}
            data-tags={item.tags.join(',')}
          >
            <ArticleCard item={item} />
          </div>
        ))
      }
    </div>
  </div>

  <script is:inline>
    (() => {
      const items = document.querySelectorAll('.article-item');
      const colBtns = document.querySelectorAll('.col-filter-btn');
      const tagBtns = document.querySelectorAll('.tag-filter-btn');

      let activeCol = 'all';
      let activeTag = '';

      const params = new URLSearchParams(window.location.search);
      if (params.get('tag')) activeTag = params.get('tag') || '';

      function render() {
        items.forEach((el) => {
          const col = el.getAttribute('data-collection') || '';
          const tags = (el.getAttribute('data-tags') || '').split(',');
          const matchCol = activeCol === 'all' || col === activeCol;
          const matchTag = !activeTag || tags.includes(activeTag);
          if (matchCol && matchTag) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });
      }

      colBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeCol = btn.getAttribute('data-col-filter') || 'all';
          activeTag = '';
          colBtns.forEach((b) => {
            b.classList.remove('bg-blue-600', 'text-white');
            b.classList.add('bg-white', 'text-slate-700');
          });
          btn.classList.add('bg-blue-600', 'text-white');
          btn.classList.remove('bg-white', 'text-slate-700');
          render();
        });
      });

      tagBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const t = btn.getAttribute('data-tag-filter') || '';
          activeTag = activeTag === t ? '' : t;
          render();
        });
      });

      render();
    })();
  </script>
</BaseLayout>
