---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/navigation/Breadcrumb.astro';
import { getAllPublishedContent } from '@/utils/content';
import { AIRPORT_BRANDS } from '@/data/brands';

const allContent = await getAllPublishedContent();

const fallbackIndex = [
  ...allContent.map((item) => ({
    type: '原创文章 / 教程',
    title: item.title,
    url: item.url,
    excerpt: item.excerpt,
    keywords: `${item.title} ${item.tags.join(' ')} ${item.primaryKeyword} ${item.excerpt}`.toLowerCase(),
  })),
  ...AIRPORT_BRANDS.map((brand) => ({
    type: `品牌档案 (${brand.lineType})`,
    title: `${brand.name} (${brand.englishName}) - ${brand.startingPriceLabel}`,
    url: `/brands/${brand.slug}/`,
    excerpt: brand.summary,
    keywords: `${brand.name} ${brand.englishName} ${brand.aliases.join(' ')} ${brand.lineType} ${brand.protocols.join(' ')} ${brand.couponCode} ${brand.summary}`.toLowerCase(),
  })),
];
---

<BaseLayout
  title="全站全文搜索 (Pagefind) - v2rayn指南"
  description="通过 Pagefind 全文检索引擎搜索 v2rayn指南 的全部原创评测文章、31 家机场品牌套餐参数、v2rayN 与 Clash Verge Rev 客户端教程。"
  breadcrumbs={[{ name: '站内全文搜索', url: '/search/' }]}
  noindex={true}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14" data-pagefind-ignore>
    <Breadcrumb items={[{ name: '站内全文搜索', url: '/search/' }]} />

    <div class="mb-8">
      <span class="text-xs font-bold uppercase tracking-wider text-blue-600">PAGEFIND FULL-TEXT SEARCH</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-1">
        站内全文搜索引擎
      </h1>
      <p class="text-sm sm:text-base text-slate-600 mt-2">
        支持中文关键词实时搜索全站文章标题、正文段落、31 家品牌档案与客户端排障手册。
      </p>
    </div>

    <!-- 搜索主面板 -->
    <div class="editorial-card p-6 bg-white mb-8">
      <div class="relative flex items-center gap-2">
        <input
          type="search"
          id="pagefind-custom-input"
          placeholder="输入中文或英文关键词：光速云、147永久套餐、v2rayN、Clash Verge、IEPL、Timeout..."
          class="w-full px-4 py-3.5 rounded-xl border border-slate-300 bg-slate-50 focus:bg-white text-slate-900 text-base focus:border-blue-600"
          autofocus
        />
        <button
          type="button"
          id="pagefind-clear-btn"
          class="px-4 py-3.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-bold shrink-0 cursor-pointer"
        >
          清空
        </button>
      </div>

      <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate-500">
        <span class="font-bold text-slate-700">快速检索词：</span>
        {
          ['光速云', 'v2rayN', 'Clash Verge', 'IEPL专线', '不限时', '飞猫云', '暮光加速', '星岛梦', '一翻云', 'Timeout'].map((kw) => (
            <button
              type="button"
              data-search-preset={kw}
              class="search-preset-btn px-2.5 py-1 rounded-md bg-slate-100 hover:bg-blue-50 hover:text-blue-600 cursor-pointer"
            >
              {kw}
            </button>
          ))
        }
      </div>
    </div>

    <!-- 搜索结果状态与卡片容器 -->
    <div id="search-status-bar" class="text-xs font-mono text-slate-500 mb-4">
      正在就绪 Pagefind 静态全文索引与即时品牌/文章索引...
    </div>

    <div id="search-results-container" class="space-y-4"></div>

    <!-- 空结果提示 -->
    <div id="search-empty-box" class="hidden editorial-card p-10 text-center bg-slate-50">
      <h2 class="text-lg font-extrabold text-slate-900">未找到与该关键词直接匹配的页面</h2>
      <p class="text-sm text-slate-600 mt-1.5">
        建议尝试缩短关键词（如搜索“IEPL”、“VLESS”、“订阅”或直接前往 31 家品牌数据库按条件筛选）。
      </p>
      <div class="mt-4 flex justify-center gap-3">
        <a href="/brands/" class="px-4 py-2 rounded-xl bg-blue-600 text-white text-xs font-bold">
          打开 31 家品牌数据库
        </a>
        <a href="/articles/" class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-slate-700 text-xs font-bold">
          查看全部文章列表
        </a>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ fallbackIndex }}>
    (() => {
      const input = document.getElementById('pagefind-custom-input');
      const clearBtn = document.getElementById('pagefind-clear-btn');
      const statusBar = document.getElementById('search-status-bar');
      const resultsBox = document.getElementById('search-results-container');
      const emptyBox = document.getElementById('search-empty-box');
      const presetBtns = document.querySelectorAll('.search-preset-btn');

      let pagefindInstance = null;

      async function initPagefind() {
        try {
          const pfPath = '/pagefind/pagefind.js';
          pagefindInstance = await import(/* @vite-ignore */ pfPath);
          await pagefindInstance.options({ excerptLength: 28 });
          if (statusBar && !input.value) {
            statusBar.textContent = 'Pagefind 全文检索引擎已就绪（索引包含全部静态文章与品牌档案）。';
          }
        } catch (_err) {
          if (statusBar && !input.value) {
            statusBar.textContent = '即时本地全文索引已就绪。';
          }
        }
      }

      function renderCards(items, query) {
        if (!resultsBox || !emptyBox || !statusBar) return;
        resultsBox.innerHTML = '';

        if (!query) {
          emptyBox.classList.add('hidden');
          // 默认展示前 8 条热门索引
          statusBar.textContent = `热门评测与教程推荐（共收录 ${fallbackIndex.length} 个核心条目）：`;
          fallbackIndex.slice(0, 8).forEach((item) => {
            resultsBox.appendChild(createResultElement(item));
          });
          return;
        }

        if (items.length === 0) {
          statusBar.textContent = `关键词「${query}」匹配到 0 条结果`;
          emptyBox.classList.remove('hidden');
          return;
        }

        emptyBox.classList.add('hidden');
        statusBar.textContent = `关键词「${query}」共检索到 ${items.length} 条相关结果：`;
        items.forEach((item) => {
          resultsBox.appendChild(createResultElement(item));
        });
      }

      function createResultElement(item) {
        const div = document.createElement('article');
        div.className = 'editorial-card p-5 bg-white hover:border-blue-400 transition-colors';
        div.innerHTML = `
          <div class="flex items-center justify-between gap-2 text-xs text-slate-500 mb-1.5">
            <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-bold">${item.type || '站内页面'}</span>
            <span class="font-mono text-slate-400">${item.url}</span>
          </div>
          <h3 class="text-base sm:text-lg font-extrabold text-slate-900 hover:text-blue-600">
            <a href="${item.url}">${item.title}</a>
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-1.5 leading-relaxed">${item.excerpt}</p>
        `;
        return div;
      }

      async function performSearch(rawQuery) {
        const q = (rawQuery || '').trim();
        if (!q) {
          renderCards([], '');
          return;
        }

        const lowerQ = q.toLowerCase();
        const localMatches = fallbackIndex.filter((item) => item.keywords.includes(lowerQ));

        if (pagefindInstance) {
          try {
            const searchRes = await pagefindInstance.search(q);
            const loaded = await Promise.all(searchRes.results.slice(0, 15).map((r) => r.data()));
            const pfItems = loaded.map((d) => ({
              type: 'Pagefind 全文命中',
              title: d.meta?.title || d.url,
              url: d.url,
              excerpt: d.excerpt || '',
            }));

            // 合并 Pagefind 结果与即时品牌/文章索引并按 URL 去重
            const seen = new Set();
            const merged = [];
            for (const it of [...pfItems, ...localMatches]) {
              if (!seen.has(it.url)) {
                seen.add(it.url);
                merged.push(it);
              }
            }
            renderCards(merged, q);
            return;
          } catch (_e) {
            // 回退至即时索引
          }
        }

        renderCards(localMatches, q);
      }

      initPagefind().then(() => {
        const params = new URLSearchParams(window.location.search);
        const initialQ = params.get('q') || '';
        if (initialQ && input) {
          input.value = initialQ;
        }
        performSearch(initialQ);
      });

      input?.addEventListener('input', (e) => {
        performSearch(e.target.value);
      });

      clearBtn?.addEventListener('click', () => {
        if (input) input.value = '';
        performSearch('');
        input?.focus();
      });

      presetBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const kw = btn.getAttribute('data-search-preset') || '';
          if (input) input.value = kw;
          performSearch(kw);
        });
      });
    })();
  </script>
</BaseLayout>
