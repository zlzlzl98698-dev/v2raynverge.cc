---
import { SITE_CONFIG } from '@/data/site';
import { PRIMARY_CATEGORIES } from '@/data/navigation';
import { TOP_RECOMMENDED_BRANDS } from '@/data/brands';
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800 mt-20" data-pagefind-ignore>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-8 pb-12 border-b border-slate-800">
      <!-- 网站介绍与商业合规声明 -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <img
            src="/images/logo.png"
            alt={SITE_CONFIG.brandName}
            width="36"
            height="36"
            class="w-9 h-9 rounded-xl object-contain shadow-sm"
          />
          <div>
            <span class="text-lg font-extrabold text-white">{SITE_CONFIG.brandName}</span>
            <span class="ml-2 text-xs font-mono text-blue-400">{SITE_CONFIG.domain}</span>
          </div>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed">
          {SITE_CONFIG.description}
        </p>
        <div class="p-3.5 rounded-xl bg-slate-800/80 border border-slate-700/80 text-xs text-slate-400 space-y-1.5">
          <p class="font-semibold text-slate-200">商业推广与独立评测披露：</p>
          <p>{SITE_CONFIG.disclosure.affiliateNotice}</p>
          <p>{SITE_CONFIG.disclosure.editorialIndependence}</p>
        </div>
        <p class="text-xs text-slate-400">
          编辑部联系邮箱：<a href={`mailto:${SITE_CONFIG.contactEmail}`} class="text-blue-400 hover:underline">{SITE_CONFIG.contactEmail}</a>
        </p>
      </div>

      <!-- 四大一级栏目及核心二级入口 -->
      {
        PRIMARY_CATEGORIES.map((category) => (
          <div>
            <h3 class="text-sm font-bold text-white tracking-wide mb-3.5">
              <a href={category.url} class="hover:text-blue-400 transition-colors">
                {category.name}
              </a>
            </h3>
            <ul class="space-y-2 text-xs text-slate-400">
              {category.topics.map((topic) => (
                <li>
                  <a href={topic.url} class="hover:text-white transition-colors">
                    {topic.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- 品牌数据库快捷索引 -->
    <div class="py-6 border-b border-slate-800">
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="font-bold text-slate-200 mr-2">热门评测品牌库：</span>
        {
          TOP_RECOMMENDED_BRANDS.map((brand) => (
            <a
              href={`/brands/${brand.slug}/`}
              class="px-2.5 py-1 rounded-md bg-slate-800 hover:bg-blue-600 text-slate-300 hover:text-white transition-colors"
            >
              {brand.name}
            </a>
          ))
        }
        <a
          href="/brands/"
          class="px-2.5 py-1 rounded-md bg-blue-950 text-blue-300 border border-blue-800 hover:bg-blue-900 transition-colors font-semibold"
        >
          查看全部 31 家品牌数据库 &rarr;
        </a>
      </div>
    </div>

    <!-- 底部版权、隐私政策、使用声明与 Sitemap -->
    <div class="pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-slate-400">
      <div>
        <p>&copy; 2020–2026 {SITE_CONFIG.brandName} ({SITE_CONFIG.domain}). 保留所有原创评测与图表版权。</p>
        <p class="mt-1 text-slate-500">{SITE_CONFIG.disclosure.riskWarning}</p>
      </div>
      <div class="flex flex-wrap items-center gap-4 shrink-0">
        <a href="/brands/" class="hover:text-white">品牌数据库</a>
        <a href="/articles/" class="hover:text-white">全部文章</a>
        <a href="/reviews/" class="hover:text-white">深度评测</a>
        <a href="/comparisons/" class="hover:text-white">横向对比</a>
        <a href="/guides/" class="hover:text-white">客户端教程</a>
        <a href="/about/" class="hover:text-white">关于与声明</a>
        <a href="/sitemap-index.xml" class="text-blue-400 hover:underline font-mono">Sitemap.xml</a>
      </div>
    </div>
  </div>
</footer>
