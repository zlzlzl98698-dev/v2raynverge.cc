---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  items: FAQItem[];
}

const {
  title = '常见问题解答 (FAQ)',
  subtitle = '基于真实测试记录与常见故障场景整理，结论可直接独立引用。',
  items = [],
} = Astro.props;
---

{
  items.length > 0 && (
    <section class="my-10" aria-labelledby="faq-section-heading">
      <div class="mb-5">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-bold mb-2">
          <span>GEO / AEO 权威问答</span>
        </div>
        <h2 id="faq-section-heading" class="text-xl sm:text-2xl font-extrabold text-slate-900">
          {title}
        </h2>
        <p class="text-sm text-slate-600 mt-1">{subtitle}</p>
      </div>

      <div class="space-y-3">
        {items.map((faq, idx) => (
          <details
            class="group editorial-card p-4 sm:p-5 bg-white open:border-blue-300"
            open={idx === 0}
          >
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-bold text-slate-900 text-[15px] sm:text-base">
              <span class="flex items-start gap-2.5">
                <span class="inline-flex items-center justify-center w-6 h-6 rounded-lg bg-blue-50 text-blue-600 text-xs font-mono shrink-0 mt-0.5">
                  Q{idx + 1}
                </span>
                <span>{faq.question}</span>
              </span>
              <svg
                class="w-5 h-5 text-slate-400 shrink-0 mt-0.5 transition-transform group-open:rotate-180 group-open:text-blue-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="mt-3 pt-3 border-t border-slate-100 pl-8 text-sm sm:text-[15px] text-slate-700 leading-relaxed">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>
  )
}
