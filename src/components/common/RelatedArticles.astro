---
import type { UnifiedContentItem } from '@/utils/content';
import RelatedArticleCard from '@/components/cards/RelatedArticleCard.astro';

export interface Props {
  items: UnifiedContentItem[];
  title?: string;
}

const { items = [], title = '延伸阅读与关联评测' } = Astro.props;
---

{
  items.length > 0 && (
    <section class="my-10 pt-8 border-t border-slate-200" aria-label={title}>
      <div class="flex items-center justify-between mb-5">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600">INTERNAL LINK CLUSTER</span>
          <h2 class="text-xl font-extrabold text-slate-900 mt-0.5">{title}</h2>
        </div>
        <a href="/articles/" class="text-xs sm:text-sm font-semibold text-blue-600 hover:underline">
          查看全部文章 &rarr;
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {items.slice(0, 6).map((item) => (
          <RelatedArticleCard item={item} />
        ))}
      </div>
    </section>
  )
}
