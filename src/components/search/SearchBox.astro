---
export interface Props {
  placeholder?: string;
  compact?: boolean;
}

const {
  placeholder = '输入关键词搜索：光速云、v2rayN教程、Clash Verge订阅、IEPL专线、Timeout排障...',
  compact = false,
} = Astro.props;
---

<div class:list={['w-full', compact ? '' : 'editorial-card p-5 sm:p-6 bg-white']}>
  <form action="/search/" method="get" class="relative flex items-center gap-2">
    <div class="relative flex-1">
      <svg
        class="w-5 h-5 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" />
      </svg>
      <input
        type="search"
        name="q"
        id={compact ? 'hero-search-input' : 'page-search-input'}
        placeholder={placeholder}
        class="w-full pl-11 pr-4 py-3 rounded-xl border border-slate-200 bg-slate-50/70 focus:bg-white text-slate-900 text-sm sm:text-[15px] placeholder:text-slate-400 focus:border-blue-600 transition-colors"
      />
    </div>
    <button
      type="submit"
      class="px-5 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm shrink-0 transition-colors cursor-pointer"
    >
      搜索全站
    </button>
  </form>

  {
    !compact && (
      <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate-500">
        <span class="font-semibold text-slate-700">热门搜索词：</span>
        <a href="/search/?q=光速云" class="px-2.5 py-1 rounded-md bg-slate-100 hover:bg-blue-50 hover:text-blue-600">光速云</a>
        <a href="/search/?q=v2rayN" class="px-2.5 py-1 rounded-md bg-slate-100 hover:bg-blue-50 hover:text-blue-600">v2rayN教程</a>
        <a href="/search/?q=Clash+Verge" class="px-2.5 py-1 rounded-md bg-slate-100 hover:bg-blue-50 hover:text-blue-600">Clash Verge订阅</a>
        <a href="/search/?q=IEPL" class="px-2.5 py-1 rounded-md bg-slate-100 hover:bg-blue-50 hover:text-blue-600">IEPL专线</a>
        <a href="/search/?q=不限时" class="px-2.5 py-1 rounded-md bg-slate-100 hover:bg-blue-50 hover:text-blue-600">不限时流量包</a>
        <a href="/search/?q=Timeout" class="px-2.5 py-1 rounded-md bg-slate-100 hover:bg-blue-50 hover:text-blue-600">节点Timeout超时</a>
      </div>
    )
  }
</div>
