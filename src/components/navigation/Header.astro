---
import { SITE_CONFIG } from '@/data/site';
import Navigation from './Navigation.astro';
import MobileMenu from './MobileMenu.astro';
---

<header class="sticky top-0 z-40 w-full bg-white/95 backdrop-blur-md border-b border-slate-200/90">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- 品牌 Logo 与主标 -->
    <a href="/" class="flex items-center gap-3 group shrink-0" aria-label={`${SITE_CONFIG.brandName} 首页`}>
      <img
        src="/images/logo.png"
        alt={SITE_CONFIG.brandName}
        width="40"
        height="40"
        class="w-10 h-10 rounded-xl object-contain shadow-sm group-hover:scale-105 transition-transform"
      />
      <div>
        <div class="flex items-center gap-2">
          <span class="text-lg font-extrabold tracking-tight text-slate-900 group-hover:text-blue-600 transition-colors">
            {SITE_CONFIG.brandName}
          </span>
          <span class="hidden sm:inline-block text-[11px] font-mono font-semibold px-2 py-0.5 rounded-md bg-blue-50 text-blue-600 border border-blue-100">
            v2raynverge.cc
          </span>
        </div>
        <p class="text-[11px] text-slate-500 hidden sm:block leading-none mt-0.5">
          专线机场评测 · v2rayN & Clash 知识库
        </p>
      </div>
    </a>

    <!-- 严格四大一级主导航 -->
    <Navigation />

    <!-- 右侧站内搜索与品牌库快捷入口 -->
    <div class="flex items-center gap-2.5">
      <a
        href="/search/"
        class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-blue-600 text-sm font-medium transition-colors"
        aria-label="站内全文搜索"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" />
        </svg>
        <span class="hidden md:inline">搜索文章 / 品牌...</span>
        <kbd class="hidden xl:inline-block text-[11px] px-1.5 py-0.5 rounded bg-white text-slate-400 border border-slate-200 font-mono">
          /
        </kbd>
      </a>

      <a
        href="/brands/"
        class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold shadow-xs transition-colors"
      >
        <span>品牌数据库</span>
        <span class="text-xs px-1.5 py-0.2 rounded-full bg-blue-500 text-white font-mono">31</span>
      </a>

      <MobileMenu />
    </div>
  </div>
</header>
