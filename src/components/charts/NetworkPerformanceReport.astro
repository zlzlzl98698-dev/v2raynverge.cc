---
import type { AirportBrand } from '@/data/brands';

export interface Props {
  brand: AirportBrand;
}

const { brand } = Astro.props;
const hasData = brand.speedTests && brand.speedTests.length > 0;

const validLatencies = brand.speedTests
  .map((s) => s.latencyMs)
  .filter((v): v is number => typeof v === 'number');
const avgLatency =
  validLatencies.length > 0
    ? Math.round(validLatencies.reduce((a, b) => a + b, 0) / validLatencies.length)
    : null;

const validDownloads = brand.speedTests
  .map((s) => s.downloadMbps)
  .filter((v): v is number => typeof v === 'number');
const maxDownload = validDownloads.length > 0 ? Math.max(...validDownloads) : null;
---

<section
  class="observatory-panel p-5 sm:p-6 my-8 shadow-lg"
  style={`--brand-accent: ${brand.accentColor};`}
  aria-label={`${brand.name} 网络性能测速可观测性报告`}
>
  <!-- 顶部监控台状态栏 -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-700/80">
    <div class="flex items-center gap-3">
      <span
        class="w-3 h-3 rounded-full shrink-0"
        style={`background-color: ${hasData ? '#10B981' : '#F59E0B'}; box-shadow: 0 0 10px ${hasData ? '#10B981' : '#F59E0B'};`}
      ></span>
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <h3 class="text-base sm:text-lg font-extrabold text-white tracking-tight">
            {brand.name} · Network Performance Report
          </h3>
          <span class="px-2 py-0.5 rounded text-[11px] font-mono font-semibold bg-slate-800 text-sky-300 border border-slate-700">
            {hasData ? 'MEASURED DATA' : 'NOT TESTED / PENDING'}
          </span>
        </div>
        <p class="text-xs text-slate-400 font-mono mt-0.5">
          测试日期: {brand.speedTestDate} | 环境: {brand.speedTestEnv} | 线路: {brand.lineType}
        </p>
      </div>
    </div>

    <div class="flex items-center gap-3 text-xs font-mono">
      <div class="px-3 py-1.5 rounded-lg bg-slate-900/90 border border-slate-700">
        <span class="text-slate-400">平均延迟: </span>
        <strong class="text-emerald-400">{avgLatency ? `${avgLatency}ms` : '—'}</strong>
      </div>
      <div class="px-3 py-1.5 rounded-lg bg-slate-900/90 border border-slate-700">
        <span class="text-slate-400">峰值下载: </span>
        <strong class="text-sky-400">{maxDownload ? `${maxDownload} Mbps` : '—'}</strong>
      </div>
    </div>
  </div>

  <!-- 节点测速条矩阵 -->
  {
    hasData ? (
      <div class="mt-5 space-y-4">
        {brand.speedTests.map((node) => {
          const pct = node.downloadMbps ? Math.min(100, Math.max(8, Math.round((node.downloadMbps / 600) * 100))) : 10;
          const isFast = (node.downloadMbps || 0) >= 350;
          const barColor = isFast ? '#10B981' : (node.downloadMbps || 0) >= 100 ? '#38BDF8' : '#F59E0B';
          return (
            <div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800">
              <div class="flex flex-wrap items-center justify-between gap-2 text-xs sm:text-sm mb-2">
                <div class="flex items-center gap-2.5">
                  <span
                    class="w-2 h-2 rounded-full"
                    style={`background-color: ${barColor};`}
                  />
                  <span class="font-bold text-slate-100">{node.region} 专线节点</span>
                  <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-300">
                    {node.status}
                  </span>
                </div>
                <div class="flex items-center gap-4 font-mono text-xs">
                  <span>
                    延迟 RTT: <strong class="text-emerald-400">{node.latency}</strong>
                  </span>
                  <span>
                    下行速率: <strong class="text-sky-300">{node.download}</strong>
                  </span>
                  <span class="text-slate-500 hidden sm:inline">丢包率: 0.0% (基准)</span>
                </div>
              </div>
              <div class="w-full h-2.5 bg-slate-800 rounded-full overflow-hidden">
                <div
                  class="h-full rounded-full"
                  style={`width: ${pct}%; background-color: ${barColor};`}
                />
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="my-6 p-6 rounded-xl bg-slate-900/75 border border-dashed border-slate-700 text-center">
        <p class="text-sm font-mono text-amber-300 font-semibold">
          [ TELEMETRY STATUS: NO VERIFIED REGIONAL SPEEDTEST TABLE ]
        </p>
        <p class="text-xs text-slate-400 mt-1.5 max-w-2xl mx-auto">
          根据本站真实性原则，{brand.name} 当前资料未包含可核实的逐地区延迟与带宽实测表，严禁使用演示数值冒充真实实测。建议以小额月付套餐自行验证本地运营商表现。
        </p>
      </div>
    )
  }

  <!-- HTML 文字可读摘要（供搜索引擎与辅助技术读取） -->
  <div class="mt-5 pt-3.5 border-t border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-slate-400">
    <p>
      <strong>图表数据文字说明：</strong>
      {
        hasData
          ? `${brand.name} 在 ${brand.speedTestDate} 的测试记录涵盖 ${brand.speedTests.map((n) => `${n.region}(延迟${n.latency}/下载${n.download})`).join('、')}。`
          : `${brand.name} 目前处于“${brand.dataStatusLabel}”状态，尚未录入分地区 Speedtest 实测数值。`
      }
    </p>
    <span class="font-mono text-[11px] text-slate-500 shrink-0">[v2raynverge.cc Network Lab]</span>
  </div>
</section>
