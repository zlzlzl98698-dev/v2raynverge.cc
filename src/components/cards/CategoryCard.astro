---
import type { PrimaryCategory } from '@/data/navigation';

export interface Props {
  category: PrimaryCategory;
}

const { category } = Astro.props;
---

<div class="editorial-card p-5 sm:p-6 bg-white flex flex-col justify-between group">
  <div>
    <div class="flex items-center justify-between mb-3">
      <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-600 border border-blue-100">
        {category.badge}
      </span>
      <span class="text-xs font-mono text-slate-400">{category.topics.length} 个二级专题</span>
    </div>
    <h3 class="text-lg sm:text-xl font-extrabold text-slate-900 group-hover:text-blue-600 transition-colors">
      <a href={category.url}>{category.name}</a>
    </h3>
    <p class="text-xs sm:text-sm text-slate-600 mt-2 line-clamp-2 leading-relaxed">
      {category.description}
    </p>

    <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap gap-1.5">
      {
        category.topics.map((topic) => (
          <a
            href={topic.url}
            class="text-xs px-2.5 py-1 rounded-lg bg-slate-50 hover:bg-blue-50 text-slate-700 hover:text-blue-600 border border-slate-200/80 transition-colors"
          >
            {topic.name}
          </a>
        ))
      }
    </div>
  </div>

  <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-blue-600">
    <a href={category.url} class="hover:underline">
      进入「{category.name}」专题总览 &rarr;
    </a>
    <span class="text-slate-400 font-mono">{category.url}</span>
  </div>
</div>
