---
import type { AirportBrand } from '@/data/brands';
import { SITE_CONFIG } from '@/data/site';

export interface Props {
  brand: AirportBrand;
  showAffiliateButton?: boolean;
}

const { brand, showAffiliateButton = true } = Astro.props;

const statusColors: Record<AirportBrand['dataStatus'], string> = {
  measured: 'bg-emerald-50 text-emerald-700 border-emerald-200',
  vendor: 'bg-blue-50 text-blue-700 border-blue-200',
  historical: 'bg-amber-50 text-amber-700 border-amber-200',
  pending: 'bg-slate-100 text-slate-600 border-slate-300',
};

const statusShortLabel: Record<AirportBrand['dataStatus'], string> = {
  measured: '已实测核实',
  vendor: '品牌资料核实',
  historical: '历史档案记录',
  pending: '部分待核实',
};
---

<article class="editorial-card p-5 bg-white flex flex-col justify-between h-full relative">
  <div>
    <!-- 顶部品牌信息与状态徽章 -->
    <div class="flex items-start justify-between gap-3 mb-3.5">
      <div class="flex items-center gap-3">
        <img
          src={brand.logo}
          alt={`${brand.name} 品牌 Logo`}
          width="48"
          height="48"
          loading="lazy"
          class="w-12 h-12 rounded-xl object-cover border border-slate-200 bg-slate-50 shrink-0"
        />
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h3 class="text-base sm:text-lg font-extrabold text-slate-900 hover:text-blue-600 transition-colors">
              <a href={`/brands/${brand.slug}/`}>{brand.name}</a>
            </h3>
            {brand.isPrimaryPromoted && (
              <span class="px-2 py-0.5 rounded-md text-[11px] font-bold bg-blue-600 text-white">
                本站首选合作推荐
              </span>
            )}
          </div>
          <p class="text-xs text-slate-500 mt-0.5">
            {brand.foundedYear !== '待核实' ? `${brand.foundedYear}年运营` : '年份待核实'} &middot; {brand.lineType}
          </p>
        </div>
      </div>

      <span class:list={['px-2 py-0.5 rounded-full text-[11px] font-semibold border shrink-0', statusColors[brand.dataStatus]]}>
        {statusShortLabel[brand.dataStatus]}
      </span>
    </div>

    <!-- 核心参数标签网格 -->
    <div class="grid grid-cols-2 gap-2 p-3 rounded-xl bg-slate-50 border border-slate-100 text-xs mb-3.5">
      <div>
        <span class="text-slate-400 block">参考起步成本</span>
        <span class="font-bold text-slate-900">{brand.startingPriceLabel}</span>
      </div>
      <div>
        <span class="text-slate-400 block">客户端方式</span>
        <span class="font-semibold text-slate-800">{brand.clientSupport}</span>
      </div>
      <div>
        <span class="text-slate-400 block">支持协议</span>
        <span class="font-mono text-slate-700">{brand.protocols.join(' / ')}</span>
      </div>
      <div>
        <span class="text-slate-400 block">优惠码</span>
        <span class="font-mono font-bold text-blue-600">{brand.couponCode}</span>
      </div>
    </div>

    <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed">
      {brand.summary}
    </p>
  </div>

  <div class="mt-4 pt-3.5 border-t border-slate-100 space-y-2">
    <div class="flex items-center gap-2">
      <a
        href={`/brands/${brand.slug}/`}
        class="flex-1 text-center py-2 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs sm:text-sm font-bold transition-colors"
      >
        查看评测与套餐表
      </a>
      {
        showAffiliateButton && (
          <a
            href={brand.affiliateUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="flex-1 text-center py-2 px-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs sm:text-sm font-bold transition-colors"
          >
            访问官网入口 &nearr;
          </a>
        )
      }
    </div>
    {
      showAffiliateButton && (
        <p class="text-[11px] text-slate-400 leading-tight">
          * {SITE_CONFIG.disclosure.affiliateNotice}
        </p>
      )
    }
  </div>
</article>
