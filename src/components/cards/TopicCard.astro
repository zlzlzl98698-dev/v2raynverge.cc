---
import type { SecondaryTopic } from '@/data/navigation';

export interface Props {
  topic: SecondaryTopic;
}

const { topic } = Astro.props;
---

<div class="editorial-card p-5 bg-white flex flex-col justify-between group h-full">
  <div>
    <div class="flex items-center justify-between gap-2 mb-2.5">
      <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-blue-50 text-blue-600">
        {topic.badge}
      </span>
      <span class="text-[11px] font-mono text-slate-400">主词：{topic.primaryKeyword}</span>
    </div>
    <h3 class="text-base sm:text-lg font-extrabold text-slate-900 group-hover:text-blue-600 transition-colors">
      <a href={topic.url}>{topic.name}</a>
    </h3>
    <p class="text-xs sm:text-sm text-slate-600 mt-2 line-clamp-3 leading-relaxed">
      {topic.intro}
    </p>
  </div>

  <div class="mt-4 pt-3 border-t border-slate-100 space-y-2">
    <div class="text-[11px] text-slate-500">
      <span class="font-semibold text-slate-700">关联三级集群：</span>
      {topic.clusters.map((c) => c.name).join(' · ')}
    </div>
    <div class="flex items-center justify-between text-xs font-bold text-blue-600 pt-1">
      <a href={topic.url} class="hover:underline">进入专题页 &rarr;</a>
      <span class="text-[11px] font-mono text-slate-400">{topic.url}</span>
    </div>
  </div>
</div>
