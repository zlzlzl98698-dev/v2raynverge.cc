---
import type { AirportBrand, BrandPlan } from '@/data/brands';
import { SITE_CONFIG } from '@/data/site';

export interface Props {
  brand: AirportBrand;
  plan: BrandPlan;
  highlight?: boolean;
}

const { brand, plan, highlight = false } = Astro.props;
---

<div
  class:list={[
    'editorial-card p-5 flex flex-col justify-between h-full',
    highlight ? 'border-blue-500 ring-2 ring-blue-500/15 bg-blue-50/20' : 'bg-white',
  ]}
>
  <div>
    <div class="flex items-center justify-between gap-2 mb-2.5">
      <span class="text-xs font-bold text-blue-600">{brand.name} · {brand.lineType}</span>
      <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-700">
        {plan.billingCycle}
      </span>
    </div>

    <h4 class="text-base font-extrabold text-slate-900">{plan.name}</h4>

    <div class="my-3.5 flex items-baseline gap-2">
      <span class="text-2xl sm:text-3xl font-black text-slate-900 font-mono">{plan.price}</span>
      <span class="text-xs text-slate-500 font-medium">({plan.monthlyEquivalent})</span>
    </div>

    <ul class="space-y-1.5 text-xs text-slate-600 border-t border-slate-100 pt-3">
      <li class="flex items-center justify-between">
        <span class="text-slate-400">流量额度：</span>
        <span class="font-bold text-slate-800">{plan.traffic}</span>
      </li>
      <li class="flex items-center justify-between">
        <span class="text-slate-400">重置规则：</span>
        <span class="font-medium text-slate-700">{plan.resetCycle}</span>
      </li>
      <li class="flex items-center justify-between">
        <span class="text-slate-400">支持协议：</span>
        <span class="font-mono text-slate-700">{brand.protocols.join('/')}</span>
      </li>
      {plan.notes && (
        <li class="text-[11px] text-amber-700 bg-amber-50 px-2.5 py-1.5 rounded-lg mt-2">
          注：{plan.notes}
        </li>
      )}
    </ul>
  </div>

  <div class="mt-4 pt-3 border-t border-slate-100 space-y-2">
    <div class="flex items-center gap-2">
      <a
        href={`/brands/${brand.slug}/`}
        class="flex-1 text-center py-2 px-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-colors"
      >
        品牌详情
      </a>
      <a
        href={brand.affiliateUrl}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="flex-1 text-center py-2 px-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold transition-colors"
      >
        官网选购 &nearr;
      </a>
    </div>
    <p class="text-[10px] text-slate-400 leading-tight">
      * {SITE_CONFIG.disclosure.affiliateNotice}
    </p>
  </div>
</div>
