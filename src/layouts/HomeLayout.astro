---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  faq?: { question: string; answer: string }[];
  itemList?: { name: string; url: string; position?: number }[];
}

const { title, description, faq = [], itemList = [] } = Astro.props;
---

<BaseLayout title={title} description={description} faq={faq} itemList={itemList}>
  <slot />
</BaseLayout>
