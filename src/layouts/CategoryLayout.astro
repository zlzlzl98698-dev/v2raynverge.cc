---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@/components/navigation/Breadcrumb.astro';
import TopicCard from '@/components/cards/TopicCard.astro';
import ArticleCard from '@/components/cards/ArticleCard.astro';
import BrandCard from '@/components/cards/BrandCard.astro';
import type { PrimaryCategory } from '@/data/navigation';
import { getAllPublishedContent } from '@/utils/content';
import { getBrandsBySlugs } from '@/data/brands';

export interface Props {
  category: PrimaryCategory;
}

const { category } = Astro.props;
const allContent = await getAllPublishedContent();
const categoryArticles = allContent.filter((item) => item.category === category.id);
const displayArticles = categoryArticles.length > 0 ? categoryArticles : allContent.slice(0, 6);

const brandSlugs = Array.from(
  new Set(category.topics.flatMap((t) => t.featuredBrandSlugs))
).slice(0, 6);
const featuredBrands = getBrandsBySlugs(brandSlugs);

const itemList = category.topics.map((t, idx) => ({
  name: t.name,
  url: t.url,
  position: idx + 1,
}));
---

<BaseLayout
  title={`${category.heroTitle} - ${category.name}频道`}
  description={category.description}
  breadcrumbs={[{ name: category.name, url: category.url }]}
  itemList={itemList}
>
  <!-- 频道顶部 Hero -->
  <section class="bg-gradient-to-b from-blue-50/80 via-slate-50/50 to-white border-b border-slate-200 py-10 sm:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumb items={[{ name: category.name, url: category.url }]} />

      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-600 text-white text-xs font-bold mb-3">
          <span>一级主题频道 · {category.badge}</span>
          <span>&middot;</span>
          <span>下辖 7 个二级专题与 14 个三级内容集群</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
          {category.heroTitle}
        </h1>
        <p class="text-base sm:text-lg text-slate-600 mt-3 leading-relaxed">
          {category.heroSubtitle}
        </p>
      </div>

      <!-- 7 个二级专题快速药丸导航 -->
      <div class="mt-6 pt-6 border-t border-slate-200/80 flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold text-slate-500 mr-1">本频道二级专题直达：</span>
        {
          category.topics.map((topic) => (
            <a
              href={topic.url}
              class="px-3.5 py-2 rounded-xl bg-white hover:bg-blue-600 text-slate-800 hover:text-white border border-slate-200 text-xs sm:text-sm font-bold shadow-2xs transition-colors"
            >
              {topic.name}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    <!-- 1. 7个二级专题矩阵 -->
    <section aria-labelledby="secondary-topics-heading">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600">PILLAR TO CLUSTER MATRIX</span>
          <h2 id="secondary-topics-heading" class="text-2xl font-extrabold text-slate-900 mt-1">
            「{category.name}」7 大二级专题中心
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-slate-500">
          每个二级专题均具有独立路由、搜索意图拆解与 2 个专属三级文章集群
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {category.topics.map((topic) => <TopicCard topic={topic} />)}
      </div>
    </section>

    <!-- 2. 本频道精选原创文章与教程 -->
    <section aria-labelledby="category-articles-heading" class="pt-10 border-t border-slate-200">
      <div class="flex items-center justify-between mb-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600">ORIGINAL ARTICLES & GUIDES</span>
          <h2 id="category-articles-heading" class="text-2xl font-extrabold text-slate-900 mt-1">
            {category.name} 深度长文与实操指南
          </h2>
        </div>
        <a href="/articles/" class="text-sm font-bold text-blue-600 hover:underline">
          查看全部文章 &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {displayArticles.map((article) => <ArticleCard item={article} />)}
      </div>
    </section>

    <!-- 3. 14个三级内容集群与GEO长尾问答索引 -->
    <section aria-labelledby="tertiary-clusters-heading" class="pt-10 border-t border-slate-200">
      <div class="mb-6">
        <span class="text-xs font-bold uppercase tracking-wider text-blue-600">TERTIARY CLUSTERS & GEO Q&A</span>
        <h2 id="tertiary-clusters-heading" class="text-2xl font-extrabold text-slate-900 mt-1">
          本频道下辖 14 个三级文章集群与 GEO 核心问题库
        </h2>
        <p class="text-sm text-slate-600 mt-1">
          采用 Answer-First 结构覆盖用户在 Google、Bing、ChatGPT 与 Perplexity 中的真实长尾提问。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {
          category.topics.flatMap((topic) =>
            topic.clusters.map((cluster) => (
              <div class="editorial-card p-5 bg-slate-50/70 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between gap-2 text-xs mb-2">
                    <a href={topic.url} class="font-bold text-blue-600 hover:underline">
                      所属专题：{topic.name}
                    </a>
                    <span class="px-2 py-0.5 rounded bg-white border border-slate-200 text-slate-600 text-[11px]">
                      {cluster.searchIntent}
                    </span>
                  </div>
                  <h3 class="text-base font-extrabold text-slate-900">{cluster.name}</h3>
                  <p class="text-xs text-slate-600 mt-1.5">{cluster.summary}</p>
                  <div class="mt-3 pt-2.5 border-t border-slate-200/70 space-y-1 text-xs text-slate-700">
                    {cluster.geoQuestions.map((q) => (
                      <p class="flex items-start gap-1.5">
                        <span class="text-blue-600 font-bold shrink-0">Q:</span>
                        <span>{q}</span>
                      </p>
                    ))}
                  </div>
                </div>
                <div class="mt-4 pt-2.5 border-t border-slate-200/70 flex items-center justify-between text-xs">
                  <span class="text-slate-500">主关键词：<strong class="text-slate-800">{cluster.targetKeyword}</strong></span>
                  <a href={`/articles/${cluster.coreArticleSlug}/`} class="font-bold text-blue-600 hover:underline">
                    阅读核心支柱文 &rarr;
                  </a>
                </div>
              </div>
            ))
          )
        }
      </div>
    </section>

    <!-- 4. 关联品牌推荐矩阵 -->
    <section aria-labelledby="category-brands-heading" class="pt-10 border-t border-slate-200">
      <div class="flex items-center justify-between mb-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600">VERIFIED BRAND DATABASE</span>
          <h2 id="category-brands-heading" class="text-2xl font-extrabold text-slate-900 mt-1">
            本频道重点关联机场品牌档案
          </h2>
        </div>
        <a href="/brands/" class="text-sm font-bold text-blue-600 hover:underline">
          进入 31 家品牌数据库筛选 &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredBrands.map((brand) => <BrandCard brand={brand} />)}
      </div>
    </section>

    <slot />
  </div>
</BaseLayout>
