---
import '@/styles/global.css';
import SEOHead, { type BreadcrumbItem } from '@/components/seo/SEOHead.astro';
import Header from '@/components/navigation/Header.astro';
import Footer from '@/components/common/Footer.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  pubDate?: string;
  updatedDate?: string;
  author?: string;
  breadcrumbs?: BreadcrumbItem[];
  faq?: { question: string; answer: string }[];
  itemList?: { name: string; url: string; position?: number }[];
  softwareApp?: {
    name: string;
    operatingSystem: string;
    applicationCategory: string;
    price?: string;
  };
  noindex?: boolean;
}

const props = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <SEOHead {...props} />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-slate-900 antialiased selection:bg-blue-600 selection:text-white">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:rounded-xl focus:bg-blue-600 focus:text-white focus:font-bold"
    >
      跳至正文内容
    </a>

    <Header />

    <main id="main-content" class="flex-1" data-pagefind-body={props.noindex ? undefined : true}>
      <slot />
    </main>

    <Footer />

    <!-- 返回顶部轻量按钮 -->
    <button
      type="button"
      id="back-to-top"
      aria-label="返回页面顶部"
      class="fixed bottom-6 right-6 z-40 hidden items-center justify-center w-11 h-11 rounded-2xl bg-slate-900/90 hover:bg-blue-600 text-white shadow-lg transition-all cursor-pointer"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
      </svg>
    </button>

    <script is:inline>
      (() => {
        const backBtn = document.getElementById('back-to-top');
        if (backBtn) {
          window.addEventListener(
            'scroll',
            () => {
              if (window.scrollY > 420) {
                backBtn.classList.remove('hidden');
                backBtn.classList.add('flex');
              } else {
                backBtn.classList.add('hidden');
                backBtn.classList.remove('flex');
              }
            },
            { passive: true }
          );
          backBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }

        // 按 "/" 键快捷聚焦搜索框或跳转搜索页
        window.addEventListener('keydown', (e) => {
          if (e.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName || '')) {
            const searchInput = document.querySelector('input[type="search"]');
            if (searchInput) {
              e.preventDefault();
              searchInput.focus();
            }
          }
        });
      })();
    </script>
  </body>
</html>
